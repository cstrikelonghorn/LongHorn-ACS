<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <!-- The app is published self-contained; the test host is not. Referencing it for its
         types is still sound, so the SDK check that forbids the mix is turned off here only. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../windows/ACPScanner.csproj" />
    <Compile Include="../../windows/ConfigAnalyzer.cs" Link="ConfigAnalyzer.cs" />
  </ItemGroup>
</Project>
