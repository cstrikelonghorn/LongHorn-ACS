# EditorConfig — keeps code style consistent across editors.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,html,css,js}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd,ps1,sln,vcxproj,vcxproj.filters,inf}]
end_of_line = crlf

[*.{png,jpg,jpeg,gif,ico,sqlite,exe,dll,pdb,zip}]
insert_final_newline = false
