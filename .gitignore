bin/
obj/
publish/
publish-*/
windows/bin/
windows/obj/
windows/publish/
windows/publish-3.3/
windows/publish-3.3 - Copy/
windows/release/
windows/launcher/
tests/desktop/bin/
tests/desktop/obj/
*.exe
*.dll
*.pdb
*.zip

# Logs & scratch
*.log
tmp/
scratch/

# Nested repos & release-tooling output
__pycache__/
*.pyc
publication/public-repo/
publication/artifacts/
publication/staging/
publication/verification/
