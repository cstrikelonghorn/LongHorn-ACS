# Player data & runtime databases - privacy-sensitive, rebuilt on first run
reports/*.json
!reports/.htaccess
!reports/index.php
database/*.sqlite
database/*.sqlite-*
database/admin_audit.log
database/ip_geo.json
database/visitor_stats.json
database/visitor_online.json
database/backups/
ratelimit/
uploads/

