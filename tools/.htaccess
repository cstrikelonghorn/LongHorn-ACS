# Not part of the public site. These paths hold source, build output, test fixtures and
# operator tooling; serving any of them hands an attacker the detection logic or worse.
#
# NOTE FOR NGINX: .htaccess is an Apache feature and nginx ignores this file completely.
# On nginx add, inside the server block:
#     location ~ ^/(scratch|tools|tests|server|windows|whitelist|tmp|database|reports)/ { deny all; }
# The durable fix is to serve only the web files, not this whole folder - see README.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
