# Block direct HTTPS access to uploaded reports. They contain player-identifying data
# (SteamID, IP, serial) and are only ever displayed server-side by index.php.
# nginx hosts must add this instead (HestiaCP config or .htaccess override):
#   location ~ ^/reports/ { deny all; }
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
